NODE_ENV=development
PORT=3000

MARKET_WS_URL=wss://v3-prod.livefxhub.com/ws/algo
MARKET_API_KEY=
MARKET_SECRET_KEY=

# Local host connection (Compose publishes PostgreSQL on POSTGRES_HOST_PORT).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5434/pricing_engine

# Docker Compose connection from the app container to PostgreSQL.
DATABASE_URL_DOCKER=postgresql://postgres:YOUR_PASSWORD@postgres:5432/pricing_engine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=pricing_engine
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6379

# Redis sessions, rate limits, cache, and Pub/Sub
REDIS_URL=redis://localhost:6379

# Development-only KYC review key. Use a long random value locally.
# The Compose API runs in production mode, where manual review is disabled.
ADMIN_API_KEY=

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
