NODE_ENV=development
PORT=3000

# Use "mock" to validate the pipeline without provider access.
# Synthetic values are for testing only; use "live" for the configured provider.
MARKET_DATA_MODE=live
MARKET_WS_URL=wss://v3-prod.livefxhub.com/ws/algo
MARKET_API_KEY=
MARKET_SECRET_KEY=

# PostgreSQL used by Prisma for market data, merchant accounts, and KYC.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/pricing_engine

# Redis sessions, rate limits, cache, and Pub/Sub
REDIS_URL=redis://localhost:6379

# Development-only KYC review key. Use a long random value locally.
# The manual review endpoint is disabled when NODE_ENV=production.
ADMIN_API_KEY=

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
