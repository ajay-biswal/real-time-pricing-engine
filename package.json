{
  "name": "real-time-pricing-engine-workspace",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm --filter real-time-pricing-engine-backend dev",
    "dev:backend": "pnpm --filter real-time-pricing-engine-backend dev",
    "dev:frontend": "pnpm --filter pricing-engine-frontend dev",
    "build": "pnpm --filter real-time-pricing-engine-backend build && pnpm --filter pricing-engine-frontend build",
    "typecheck": "pnpm --filter real-time-pricing-engine-backend typecheck && pnpm --filter pricing-engine-frontend typecheck",
    "test": "pnpm --filter real-time-pricing-engine-backend test",
    "test:watch": "pnpm --filter real-time-pricing-engine-backend test:watch",
    "benchmark:ws": "pnpm --filter real-time-pricing-engine-backend benchmark:ws --"
  }
}
